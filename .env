# UFNS environment template — copy to .env and fill in. Never commit .env.
# Updated with real city configs for Mumbai and Vijayawada (SIH-26085).

# =============================================================
# CITY SELECTION
# Options: DEMO_KOLKATA | MUMBAI | VIJAYAWADA
# Switch cities without code changes — only change this line.
# =============================================================
UFNS_ACTIVE_CITY=MUMBAI

# =============================================================
# APPLICATION
# =============================================================
UFNS_API_HOST=0.0.0.0
UFNS_API_PORT=8000
UFNS_LOG_LEVEL=INFO
UFNS_MAX_CONCURRENT_RUNS=1
UFNS_RUN_TIMEOUT_SECONDS=1800
UFNS_ENVIRONMENT=OPERATIONAL_PRODUCTION

# =============================================================
# DATA DIRECTORIES
# =============================================================
UFNS_DATA_DIR=./data
UFNS_PILOT_ID=synthetic_wb_fixture_v1

# --- Mumbai real data paths ---
UFNS_MUMBAI_DEM=data/raw/mumbai/mumbai_dem.tif
UFNS_MUMBAI_DRAINAGE=data/raw/mumbai/mumbai_drains.geojson
UFNS_MUMBAI_ROADS=data/raw/mumbai/mumbai_roads.geojson
UFNS_MUMBAI_IDF=data/raw/mumbai/mumbai_idf.json

# Mumbai bbox (EPSG:4326)
UFNS_MUMBAI_BBOX_WEST=72.75
UFNS_MUMBAI_BBOX_SOUTH=18.88
UFNS_MUMBAI_BBOX_EAST=72.98
UFNS_MUMBAI_BBOX_NORTH=19.28
UFNS_MUMBAI_EPSG=32643

# --- Vijayawada real data paths ---
UFNS_VIJAYAWADA_DEM=data/raw/vijayawada/vijayawada_dem.tif
UFNS_VIJAYAWADA_DRAINAGE=data/raw/vijayawada/vijayawada_drains.geojson
UFNS_VIJAYAWADA_ROADS=data/raw/vijayawada/vijayawada_roads.geojson
UFNS_VIJAYAWADA_IDF=data/raw/vijayawada/vijayawada_idf.json

# Vijayawada bbox (EPSG:4326)
UFNS_VIJAYAWADA_BBOX_WEST=80.55
UFNS_VIJAYAWADA_BBOX_SOUTH=16.45
UFNS_VIJAYAWADA_BBOX_EAST=80.72
UFNS_VIJAYAWADA_BBOX_NORTH=16.58
UFNS_VIJAYAWADA_EPSG=32644

# =============================================================
# RAINFALL / NOWCAST ENGINE
# Options: SYNTHETIC | FIXTURE | OPTICAL_FLOW_ADVECTION | LIVE_RADAR_HTTP
# =============================================================
UFNS_RAIN_PROVIDER=OPTICAL_FLOW_ADVECTION
UFNS_POLL_INTERVAL_SECONDS=300

# =============================================================
# IMD RADAR (DWR) — requires MOSDAC registration
# Register at: https://www.mosdac.gov.in/internal/registration
# MOSDAC provides INSAT-3D/3DR data; radar requires IMD API access
# =============================================================
MOSDAC_USER=
MOSDAC_PASS=

# Mumbai — IMD Colaba S-band DWR
# Radar viewer:  https://mausam.imd.gov.in/imd_latest/contents/index_radar.php?id=Mumbai
# MOSDAC iframe: https://mosdac.gov.in/iframe-radar
UFNS_DWR_MUMBAI_RADAR_ID=MUM
UFNS_DWR_MUMBAI_API_URL=https://mosdac.gov.in/live/data/INSAT3DR/3DRAD

# Vijayawada — IMD Machilipatnam S-band DWR
# Radar viewer:  https://mausam.imd.gov.in/amaravati/
UFNS_DWR_VIJAYAWADA_RADAR_ID=MPT
UFNS_DWR_VIJAYAWADA_API_URL=https://mosdac.gov.in/live/data/INSAT3DR/3DRAD

# =============================================================
# RAIN GAUGE / AWS NETWORKS
# =============================================================

# Mumbai — MCGM Disaster Management AWS (60+ stations, 15-min)
# Portal: https://dm.mcgm.gov.in/
# No public REST API documented; requires municipal scraping or data-sharing agreement
UFNS_MCGM_AWS_URL=https://dm.mcgm.gov.in/

# Vijayawada — APSDMA rainfall alert system
# Portal: https://apsdma.ap.gov.in/alert_systems.php?id=1
# Flood data: https://apsdma.ap.gov.in/alert_systems.php?id=6
# Historical: https://apsdma.ap.gov.in/historical_data_events.php
UFNS_APSDMA_RAINFALL_URL=https://apsdma.ap.gov.in/alert_systems.php?id=1
UFNS_APSDMA_FLOOD_URL=https://apsdma.ap.gov.in/alert_systems.php?id=6

# =============================================================
# NWP GRIDDED FORECASTS — NCMRWF NCUM-R (GRIB2 / NetCDF4)
# Dashboard: https://nwp.ncmrwf.gov.in/forecast-dashboard
# Model:     https://nwp.ncmrwf.gov.in/HomePage/index.php
# Requires: formal NCMRWF data access request
# =============================================================
UFNS_NCMRWF_API_URL=https://nwp.ncmrwf.gov.in/
NCMRWF_API_KEY=

# =============================================================
# DEM DOWNLOAD — OpenTopography Copernicus GLO-30
# Key stored in: API AI/opentopography.txt
# =============================================================
OPENTOPO_API_KEY=b3a926c9fadf4d5794c50d24588f59a6

# =============================================================
# VEHICLE PASSABILITY POLICY
# Options: B13-DEMO-V1 | MUMBAI_DISASTER_MGMT_2026 | VMC_TRAFFIC_POLICE_2026
# =============================================================
UFNS_VEHICLE_POLICY=B13-DEMO-V1

# =============================================================
# LEGACY / DEMO SETTINGS (kept for backward compatibility)
# =============================================================
UFNS_IMD_API_KEY=

